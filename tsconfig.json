{
    "compilerOptions": {
        "target": "ES2021",
        "lib": ["ES2021", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "types": ["chrome", "vite/client", "vitest/globals"],
        "baseUrl": ".",
        "paths": {
            "@exo/*": ["src/*"],
            "@exo-e2e/*": ["e2e/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "dist-*", "**/e2e/**", "plugins", "templates"]
}
